   "source": [
    "-- Top 3 longest-running shows per genre\n",
    "WITH CTE AS (\n",
    "    SELECT\n",
    "        genre,\n",
    "        show_name,\n",
    "        runtime,\n",
    "        RANK() OVER (PARTITION BY genre ORDER BY runtime DESC) AS rnk\n",
    "    FROM tvmaze.silver.silver_shows\n",
    ")\n",
    "SELECT *\n",
    "FROM CTE\n",
    "WHERE rnk <= 3\n",
    "ORDER BY genre, rnk;\n"
   ]
  }
 ],
