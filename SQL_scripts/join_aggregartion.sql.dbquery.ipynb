   "source": [
    "-- Number of cast members per show\n",
    "SELECT\n",
    "    s.show_name,\n",
    "    s.genre,\n",
    "    COUNT(c.person_id) AS cast_count\n",
    "FROM tvmaze.silver.silver_shows s\n",
    "JOIN tvmaze.silver.silver_cast c\n",
    "    ON s.show_id = c.show_id\n",
    "GROUP BY s.show_name, s.genre\n",
    "ORDER BY cast_count DESC;\n"
   ]
  }
 ],
